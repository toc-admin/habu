# Resend (https://resend.com) — slanje upita s kontakt forme
RESEND_API_KEY=

# Na koju adresu stižu upiti (default: info@habu.hr)
CONTACT_TO_EMAIL=info@habu.hr

# Pošiljatelj — nakon verifikacije domene habu.hr na Resendu npr. "Habu web <web@habu.hr>"
# Prije verifikacije domene mora ostati onboarding@resend.dev
CONTACT_FROM_EMAIL=Habu web <onboarding@resend.dev>
